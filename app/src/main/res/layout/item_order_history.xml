<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado (Fecha + Estado) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/order_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textColor="@color/navy_blue"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/order_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:backgroundTint="@color/light_gray"
                android:background="@drawable/rounded_bg_status"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Línea divisoria -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/light_gray"/>

        <!-- Total -->
        <TextView
            android:id="@+id/order_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <!-- Productos -->
        <TextView
            android:id="@+id/order_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:visibility="visible"
            android:textColor="@color/dark_gray"/>

        <!-- Agrega esto al final del LinearLayout, antes del cierre -->
        <!-- Botón de Rastrear (visible inicialmente) -->
        <Button
            android:id="@+id/track_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rastrear Pedido"
            android:backgroundTint="@color/navy_blue"
            android:textColor="@color/white"/>

        <!-- Botón de Ver Detalle (oculto inicialmente) -->
        <Button
            android:id="@+id/view_detail_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver Detalle"
            android:backgroundTint="@color/green"
            android:textColor="@color/white"
            android:visibility="gone"
            android:layout_marginStart="8dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>