<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FFF">

    <!-- Título principal -->
    <TextView
        android:id="@+id/mainTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seguimiento de tu Pedido"
        android:textSize="22sp"
        android:textColor="#303F9F"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Tiempo de entrega -->
    <TextView
        android:id="@+id/deliveryTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Entrega estimada: 3-4 días hábiles"
        android:textSize="16sp"
        android:textColor="#4CAF50"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/mainTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Destino -->
    <TextView
        android:id="@+id/destination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Destino: Calle Prueba 123"
        android:textSize="14sp"
        android:textColor="#666"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/deliveryTime"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Línea divisoria -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/destination"/>

    <!-- Contenedor de seguimiento -->
    <LinearLayout
        android:id="@+id/trackingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <!-- Fila 1: Pedido realizado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/circle_completed"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido realizado"
                android:textSize="16sp"
                android:textColor="#000"/>
        </LinearLayout>

        <!-- Línea vertical -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#303F9F"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- Fila 2: Pago confirmado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/circle_completed"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pago confirmado"
                android:textSize="16sp"
                android:textColor="#000"/>
        </LinearLayout>

        <!-- Línea vertical -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#303F9F"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- Fila 3: Pedido empaquetado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/circle_completed"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido empaquetado"
                android:textSize="16sp"
                android:textColor="#000"/>
        </LinearLayout>

        <!-- Línea vertical -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#303F9F"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- Fila 4: Pedido enviado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/circlePedidoEnviado"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/circle_pending"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido enviado"
                android:textSize="16sp"
                android:textColor="#000"/>
        </LinearLayout>

        <!-- Línea vertical -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#303F9F"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- Fila 5: Pedido en ruta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/circlePedidoEnRuta"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/circle_pending"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido en ruta"
                android:textSize="16sp"
                android:textColor="#000"/>
        </LinearLayout>

        <!-- Línea vertical -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="#303F9F"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- Fila 6: Pedido entregado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/circleEntregado"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/circle_pending" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido entregado"
                android:textSize="16sp"
                android:textColor="#000"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Botón de confirmar entrega - AHORA MÁS PEGADO AL CONTENIDO SUPERIOR -->
    <Button
        android:id="@+id/confirmDeliveryButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Confirmar entrega"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFF"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/trackingContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
